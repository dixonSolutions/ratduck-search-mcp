{
  "name": "ratduck-search-mcp",
  "version": "0.1.0",
  "description": "MCP server that searches DuckDuckGo, scrapes arbitrary URLs, and filters/ranks results for agents. Distributed from GitHub Pages, not the npm registry.",
  "keywords": [
    "mcp",
    "model-context-protocol",
    "duckduckgo",
    "search",
    "scraper",
    "agent",
    "claude"
  ],
  "license": "MIT",
  "author": "dixonSolutions",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/dixonSolutions/ratduck-search-mcp.git"
  },
  "bugs": {
    "url": "https://github.com/dixonSolutions/ratduck-search-mcp/issues"
  },
  "homepage": "https://github.com/dixonSolutions/ratduck-search-mcp#readme",
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "bin": {
    "ratduck-search-mcp": "dist/index.js"
  },
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./ddg": {
      "types": "./dist/ddg.d.ts",
      "default": "./dist/ddg.js"
    },
    "./scrape": {
      "types": "./dist/scrape.d.ts",
      "default": "./dist/scrape.js"
    },
    "./filter": {
      "types": "./dist/filter.d.ts",
      "default": "./dist/filter.js"
    }
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json && node scripts/chmod-bin.mjs",
    "clean": "rm -rf dist",
    "dev": "tsx src/index.ts",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "node --test --import tsx test/*.test.ts",
    "test:live": "RATDUCK_LIVE=1 node --test --import tsx test/live.test.ts",
    "prepack": "npm run clean && npm run build"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.30.0",
    "cheerio": "^1.2.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@types/node": "^26.2.0",
    "tsx": "^4.23.12",
    "typescript": "^7.0.2"
  },
  "private": true,
  "allowScripts": {
    "esbuild": true
  }
}
